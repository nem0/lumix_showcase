comptime BOARD_SIZE: i32 = 8;
comptime SQUARE_SIZE: f32 = 0.9;
comptime PIECE_HEIGHT: f32 = 0.02;
comptime PIECE_Y_OFFSET: f32 = 1;
comptime CHESS_MODEL_SCALE: f32 = 0.3;
comptime HOVER_LIFT: f32 = 0.1;
comptime HOVER_BOB_AMPLITUDE: f32 = 0.05;
comptime HOVER_BOB_SPEED: f32 = 6;
comptime HOVER_SMOOTH: f32 = 12;
comptime DRAG_LIFT: f32 = 0.2;
comptime SNAP_LERP_SPEED: f32 = 10;
comptime AI_THINK_TIME: f32 = 1;
comptime AI_MAX_DEPTH: i32 = 3;
comptime INF: i32 = 100000000;
const MODEL_ROT_X90 = Quat {
	0.70710677, 0, 0, -0.70710677
};
