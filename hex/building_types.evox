struct ResourceAmounts {
	stone : i32;
	wood : i32;
	tools : i32;
	grain : i32;
	water : i32;
	happiness : i32;
	population_limit : i32;
	actions : i32;
}

struct BuildingType {
	name : []const u8;
	models : []const []const u8;
	cost : ResourceAmounts;
	one_time : ResourceAmounts;
	per_turn : ResourceAmounts;
	unlocked : bool;
}

