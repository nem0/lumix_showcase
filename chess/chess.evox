];
const WHITE_QUEEN_MODEL = "Queen_low.000.fbx:chess/Chess_Set/Chess_Set.fbx";
const BLACK_QUEEN_MODEL = "Queen_low.001.fbx:chess/Chess_Set/Chess_Set.fbx";

enum PieceType {
	PAWN, ROOK, KNIGHT, BISHOP, QUEEN, KING
}
enum Color {
	WHITE, BLACK
}

struct Piece {
	entity: Entity;
	kind: PieceType;
	color: Color;
	x: i32;
	z: i32;
	base_pos: Vec3;
	current_y: f32;
	active: bool;
	animating: bool;
	anim_start: Vec3;
	anim_target: Vec3;
	anim_time: f32;
	anim_duration: f32;
	anim_lift: f32;
	has_moved: bool;
	target_base: Vec3;
	target_y: f32;
	last_valid_base: Vec3;
	last_valid_x: i32;
	last_valid_z: i32;
	has_last_valid: bool;
}

struct Square {
	x: i32;
	z: i32;
}
struct Move {
	piece: i32;
	from_x: i32;
	from_z: i32;
	to_x: i32;
	to_z: i32;
}
struct MoveList {
	values: [256] Move;
	size: i32;
}
struct Undo {
	piece: i32;
	from_x: i32;
	from_z: i32;
	to_x: i32;
	to_z: i32;
	captured: i32;
	prev_turn: Color;
	prev_has_moved: bool;
	is_castling: bool;
	rook: i32;
	rook_from_x: i32;
	rook_to_x: i32;
	rook_prev_has_moved: bool;
	was_promotion: bool;
	old_type: PieceType;
}

var world: World = {
	null
};
var game_camera: ? Camera = null;
var board: [64] i32 = undefined;
var pieces: [32] Piece = undefined;
var piece_count: i32 = 0;
var undo_stack: [512] Undo = undefined;
var undo_count: i32 = 0;
var current_turn = Color.WHITE;
var mouse_pos = Vec2 {
	0.5, 0.5
};
var mouse_pos_valid = false;
var hovered_piece: i32 =-1;
var hover_time: f32 = 0;
var dragging = false;
var dragged_piece: i32 =-1;
var dropping = false;
var ai_timer: f32 = 0;
var ai_thinking = false;
var game_over = false;

fn minimum(a: f32, b: f32): f32 {
	return a < b ? a: b;
}

fn absf(v: f32): f32 {
	return v < 0 ? - v: v;
}

fn floori(v: f32): i32 {
	const i = v as i32;
	return v < i as f32 ? i - 1: i;
}

fn absolute(v: i32): i32 {
	return v < 0 ? - v: v;
}

fn boardIndex(x: i32, z: i32): i32 {
	return(z - 1) * BOARD_SIZE + x - 1;
}

fn at(x: i32, z: i32): i32 {
	return board[boardIndex(x, z)];
}

fn setAt(x: i32, z: i32, value: i32): void {
	board[boardIndex(x, z)] = value;
}

fn other(color: Color): Color {
	return color == .WHITE ?.BLACK:.WHITE;
}

fn squarePos(x: i32, z: i32): Vec3 {
	return {
		(x as f32 - 4.5) * SQUARE_SIZE, PIECE_HEIGHT + PIECE_Y_OFFSET,(z as f32 - 4.5) * SQUARE_SIZE
	};
}

fn position(e: Entity, p: Vec3): void {
	// Transform setters in the native Evox API assume a valid entity.

	if e.isValid() {
		e.setPosition({ p.x as f64, p.y as f64, p.z as f64 });
	}
}

fn setTurnText(text: [] const u8): void {
	const module = world.ui() else return;
	if not module.isReady() {
		return;
	}
	const elem = module.getDocument().getElementByID("turn") else return;
	elem.setText(text);
}

fn isPathClear(from_x: i32, from_z: i32, to_x: i32, to_z: i32): bool {
	const dx: i32 = to_x > from_x ? 1:(to_x < from_x ? - 1: 0);
	const dz: i32 = to_z > from_z ? 1:(to_z < from_z ? - 1: 0);
	var x = from_x + dx;
	var z = from_z + dz;
	while x != to_x or z != to_z {
		if at(x, z) >= 0 {
			return false;
		}
		x += dx;
		z += dz;
	}
	return true;
}

fn squareAttackedByPiece(index: i32, to_x: i32, to_z: i32): bool {
	const p = pieces[index];
	const dx = to_x - p.x;
	const dz = to_z - p.z;
	match p.kind {
		case .PAWN: return dz ==(p.color == .WHITE ? 1:-1) and absolute(dx) == 1;
		case .ROOK: return(dx == 0 or dz == 0) and isPathClear(p.x, p.z, to_x, to_z);
		case .KNIGHT: return(absolute(dx) == 2 and absolute(dz) == 1) or(absolute(dx) == 1 and absolute(dz) == 2);
		case .BISHOP: return absolute(dx) == absolute(dz) and isPathClear(p.x, p.z, to_x, to_z);
		case .QUEEN: return((dx == 0 or dz == 0) or absolute(dx) == absolute(dz)) and isPathClear(p.x, p.z, to_x, to_z);
		case .KING: return absolute(dx) <= 1 and absolute(dz) <= 1;
	}
}

fn isSquareAttacked(x: i32, z: i32, color: Color): bool {
	for i in 0 .. piece_count {
		if pieces[i].active and pieces[i].color == color and squareAttackedByPiece(i, x, z) {
			return true;
		}
	}
	return false;
}

fn isKingInCheck(color: Color): bool {
	for i in 0 .. piece_count {
		const p = pieces[i];
		if p.active and p.kind == .KING and p.color == color {
			return isSquareAttacked(p.x, p.z, other(color));
		}
	}
	return false;
}

fn isValidMove(index: i32, from_x: i32, from_z: i32, to_x: i32, to_z: i32): bool {
	if from_x == to_x and from_z == to_z {
		return false;
	}
	const target = at(to_x, to_z);
	const p = pieces[index];
	if target >= 0 and pieces[target].color == p.color {
		return false;
	}
	const dx = to_x - from_x;
	const dz = to_z - from_z;
	match p.kind {
		case .PAWN:
		const direction: i32 = p.color == .WHITE ? 1:-1;
		if dz == direction and dx == 0 and target < 0 {
			return true;
		}
		if dz == direction and absolute(dx) == 1 and target >= 0 and pieces[target].color != p.color {
			return true;
		}
		if (p.color == .WHITE and from_z == 2) or(p.color == .BLACK and from_z == 7) {
			if dz == 2 * direction and dx == 0 and target < 0 and at(to_x, from_z + direction) < 0 {
				return true;
			}
		}
		case .ROOK: if (dx == 0 or dz == 0) and isPathClear(from_x, from_z, to_x, to_z) {
			return true;
		}
		case .KNIGHT: if (absolute(dx) == 2 and absolute(dz) == 1) or(absolute(dx) == 1 and absolute(dz) == 2) {
			return true;
		}
		case .BISHOP: if absolute(dx) == absolute(dz) and isPathClear(from_x, from_z, to_x, to_z) {
			return true;
		}
		case .QUEEN: if ((dx == 0 or dz == 0) or absolute(dx) == absolute(dz)) and isPathClear(from_x, from_z, to_x, to_z) {
			return true;
		}
		case .KING:
		if absolute(dx) <= 1 and absolute(dz) <= 1 {
			return true;
		}
		if dz == 0 and absolute(dx) == 2 and not p.has_moved {
			const rook_x: i32 = dx > 0 ? 8: 1;
			const rook = at(rook_x, from_z);
			if rook < 0 or pieces[rook].kind != .ROOK or pieces[rook].has_moved or pieces[rook].color != p.color {
				return false;
			}
			const step: i32 = dx > 0 ? 1:-1;
			for j in 1 .. 3 {
				if at(from_x + j * step, from_z) >= 0 {
					return false;
				}
			}
			if dx < 0 and at(from_x - 3, from_z) >= 0 {
				return false;
			}
			for j in 0 .. 3 {
				if isSquareAttacked(from_x + j * step, from_z, other(p.color)) {
					return false;
				}
			}
			return true;
		}
	}
	return false;
}

fn wouldLeaveKingInCheck(index: i32, from_x: i32, from_z: i32, to_x: i32, to_z: i32): bool {
	const captured = at(to_x, to_z);
	setAt(from_x, from_z, -1);
	setAt(to_x, to_z, index);
	pieces[index].x = to_x;
	pieces[index].z = to_z;
	if captured >= 0 {
		pieces[captured].active = false;
	}
	const result = isKingInCheck(pieces[index].color);
	if captured >= 0 {
		pieces[captured].active = true;
	}
	pieces[index].x = from_x;
	pieces[index].z = from_z;
	setAt(from_x, from_z, index);
	setAt(to_x, to_z, captured);
	return result;
}

fn isLegalMove(index: i32, from_x: i32, from_z: i32, to_x: i32, to_z: i32): bool {
	return isValidMove(index, from_x, from_z, to_x, to_z) and not wouldLeaveKingInCheck(index, from_x, from_z, to_x, to_z);
}

fn getAllValidMoves(color: Color): MoveList {
	var result: MoveList = undefined;
	result.size = 0;
	for i in 0 .. piece_count {
		if pieces[i].active and pieces[i].color == color {
			for x in 1 .. 9 {
				for z in 1 .. 9 {
					if isLegalMove(i, pieces[i].x, pieces[i].z, x, z) {
						result.values[result.size] = {
							i, pieces[i].x, pieces[i].z, x, z
						};
						result.size += 1;
					}
				}
			}
		}
	}
	return result;
}

fn pieceValue(kind: PieceType): i32 {
	match kind {
		case .PAWN: return 100;
		case .KNIGHT: return 320;
		case .BISHOP: return 330;
		case .ROOK: return 500;
		case .QUEEN: return 900;
		case .KING: return 20000;
	}
}

struct PieceSquareTables {
	PAWN: [8][8] i32;
	KNIGHT: [8][8] i32;
	BISHOP: [8][8] i32;
	ROOK: [8][8] i32;
	QUEEN: [8][8] i32;
	KING: [8][8] i32;
}

