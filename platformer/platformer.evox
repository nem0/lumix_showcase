	//	end
	//end
}

fn move(w : World, td : f32) : void {
	const players = w.getEvoxData(Player);
	const player = players[0].owner;
	const e = player.getParent() else panic("Invalid scene structure");
	var position = e.getPosition();
	position.z = -4;
	e.setPosition(position);
	var ctrl = phy_ctrl.physical_controller(e) else panic("Invalid scene structure");

	var movement_speed = speed;
	if slow {
		movement_speed = movement_speed * 0.25;
	}
	var animation_speed : f32 = 0;
	if go_left or go_right {
		animation_speed = movement_speed;
	}
	if dead {
		animation_speed = 0;
	}
	if const a = animator.animator(player) {
		if speed_input_idx < 0 {
			speed_input_idx = a.getInputIndex("speed");
			jump_input_idx = a.getInputIndex("jump");
			dead_input_idx = a.getInputIndex("dead");
		}
		if speed_input_idx >= 0 {
			a.setFloatInput(speed_input_idx as u32, animation_speed);
		}
	}
	is_collision_down = ctrl.isCollisionDown();
	if is_collision_down {
		vspeed = 0;
	}
	jump = jump - td / 0.508;
	if const a = animator.animator(player) {
		if jump_input_idx >= 0 {
			a.setBoolInput(jump_input_idx as u32, jump > 0);
		}
		if dead_input_idx >= 0 {
			a.setBoolInput(dead_input_idx as u32, dead);
		}
	}
	if dead {
		return;
	}

	if jump > 0 {
		ctrl.move({0, 30 * (jump * 2 - 1) * td, 0});
	} else {
		vspeed = vspeed - 9.8 * td;
		if vspeed < -5.0 {
			vspeed = -5.0;
		}
		ctrl.move({0, 0.6 * td * vspeed * 9.8, 0});
	}

	if go_left {
		ctrl.move({1 * td * movement_speed, 0, 0});
	}
	if go_right {
		ctrl.move({-1 * td * movement_speed, 0, 0});
	}
	if go_right {
		player.setRotation({0, -0.707, 0, 0.707});
	}
	if go_left {
		player.setRotation({0, 0.707, 0, 0.707});
	}
}

fn main(input : InputSystem, world : World) : void {
	updateLivesUI(world);
	showUI(world, "respawn", false);
	showUI(world, "gameover", false);
	showUI(world, "interact", false);
	showUI(world, "menu", false);
	showCursor(world, false);
	setMusicEnabled(world, true);
	while true {
		var time_delta : f32 = yield;
		total_time += time_delta;
		updateTimeUI(world);
		handleUIEvents(world);
		handleEvents(input, world);
		if not paused {
			updateCoins(world, time_delta);
			updateTutorialLevers(world, time_delta);
			updateCheckpoints(world, time_delta);
			updatePlatforms(world, time_delta);
			processTriggers(world);
			move(world, time_delta);
		}
	}
}
