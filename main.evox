import "core:input"
import "core:world"
import "chess/chess" as chess
import "asteroids/asteroids" as asteroids
import "tower_defense/tower_defense" as tower_defense
import "platformer/platformer" as platformer

fn main(input : InputSystem, w : World) : void {
	var name = w.getPartitionName(w.getPartitionHandle(0));
	match name {
		case "chess/chess.unv": chess.main(input, w);
		case "asteroids/asteroids.unv": asteroids.main(input, w);
		case "tower_defense/tower_defense.unv": tower_defense.main(input, w);
		case "platformer/platformer.unv": platformer.main(input, w);
		case: panic("Unknown world");
	}
}
