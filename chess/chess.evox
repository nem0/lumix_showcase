	[-20, -10, -10, -5, -5, -10, -10, -20]
	],
	[
	[-30, -40, -40, -50, -50, -40, -40, -30],
	[-30, -40, -40, -50, -50, -40, -40, -30],
	[-30, -40, -40, -50, -50, -40, -40, -30],
	[-30, -40, -40, -50, -50, -40, -40, -30],
	[-20, -30, -30, -40, -40, -30, -30, -20],
	[-10, -20, -20, -20, -20, -20, -20, -10],
	[20, 20, 0, 0, 0, 0, 20, 20],
	[20, 30, 10, 0, 0, 10, 30, 20]
	]
};

fn pieceSquareValue(p: Piece): i32 {
	const row: i32 = p.color == .WHITE ? p.z - 1: 8 - p.z;
	const column = p.x - 1;
	match p.kind {
		case .PAWN: return PST.PAWN[row][column];
		case .KNIGHT: return PST.KNIGHT[row][column];
		case .BISHOP: return PST.BISHOP[row][column];
		case .ROOK: return PST.ROOK[row][column];
		case .QUEEN: return PST.QUEEN[row][column];
		case .KING: return PST.KING[row][column];
	}
}

fn evaluatePosition(color: Color): i32 {
	var score = 0;
	for i in 0 .. piece_count {
		if pieces[i].active {
			const value = pieceValue(pieces[i].kind) + pieceSquareValue(pieces[i]);
			score += pieces[i].color == color ? value:-value;
		}
	}
	if isKingInCheck(color) {
		score -= 200;
	}
	if isKingInCheck(other(color)) {
		score += 200;
	}
	return score;
}

fn evaluateMove(move: Move): i32 {
	var score = 0;
	const captured = at(move.to_x, move.to_z);
	if captured >= 0 {
		score += pieceValue(pieces[captured].kind);
	}
	const center_distance = absf(move.to_x as f32 - 4.5) + absf(move.to_z as f32 - 4.5);
	score +=((8 - center_distance) * 3) as i32;
	if pieces[move.piece].kind == .PAWN {
		const direction: i32 = pieces[move.piece].color == .WHITE ? 1:-1;
		score +=(move.to_z - move.from_z) * direction * 4;
	}
	return score;
}

fn scoreMoveForOrder(move: Move): i32 {
	var score = evaluateMove(move);
	const captured = at(move.to_x, move.to_z);
	if captured >= 0 {
		score += pieceValue(pieces[captured].kind) * 10;
	}
	return score;
}

fn orderMoves(moves: * MoveList): void {
	for i in 1 .. moves.size {
		const value = moves.values[i];
		const score = scoreMoveForOrder(value);
		var j = i;
		while j > 0 and scoreMoveForOrder(moves.values[j - 1]) < score {
			moves.values[j] = moves.values[j - 1];
			j -= 1;
		}
		moves.values[j] = value;
	}
}

fn applyTemporary(move: Move): i32 {
	const captured = at(move.to_x, move.to_z);
	setAt(move.from_x, move.from_z, -1);
	setAt(move.to_x, move.to_z, move.piece);
	pieces[move.piece].x = move.to_x;
	pieces[move.piece].z = move.to_z;
	if captured >= 0 {
		pieces[captured].active = false;
	}
	return captured;
}

fn undoTemporary(move: Move, captured: i32): void {
	if captured >= 0 {
		pieces[captured].active = true;
	}
	pieces[move.piece].x = move.from_x;
	pieces[move.piece].z = move.from_z;
	setAt(move.from_x, move.from_z, move.piece);
	setAt(move.to_x, move.to_z, captured);
}

fn minimax(color: Color, depth: i32, alpha_in: i32, beta_in: i32, maximizing: bool): i32 {
	if depth == 0 {
		return evaluatePosition(color);
	}

	const side = maximizing ? color: other(color);
	var moves = getAllValidMoves(side);
	if moves.size == 0 {
		if isKingInCheck(side) {
			return maximizing ? - 100000: 100000;
		}
		return 0;
	}
	orderMoves(& moves);
	var alpha = alpha_in;
	var beta = beta_in;
	var best: i32 = maximizing ? - INF: INF;
	for i in 0 .. moves.size {
		const move = moves.values[i];
		const captured = applyTemporary(move);
		const score = minimax(color, depth - 1, alpha, beta, not maximizing);
		undoTemporary(move, captured);
		if maximizing {
			if score > best {
				best = score;
			}
			if best > alpha {
				alpha = best;
			}
		}
		else {
			if score < best {
				best = score;
			}
			if best < beta {
				beta = best;
			}
		}
		if beta <= alpha {
			break;
		}
	}
	return best;
}

fn applyPiecePosition(index: i32): void {
	position(pieces[index].entity, { pieces[index].base_pos.x, pieces[index].current_y, pieces[index].base_pos.z });
}

fn createModel(path: [] const u8, material: [] const u8, p: Vec3): Entity {
	const e = world.createEntity();
	position(e, p);
	e.setRotation(MODEL_ROT_X90);
	e.setScale({ CHESS_MODEL_SCALE, CHESS_MODEL_SCALE, CHESS_MODEL_SCALE });
	const model = e.createModelInstance() else panic("Missing renderer");
	model.setPath(path);
	model.setMaterialOverride(0, material);
	return e;
}

fn rebuildPieceModel(index: i32): void {
	const old = pieces[index].entity;
	if old.isValid() {
		old.destroy();
	}
	var path = PIECE_MODELS[index];
	if pieces[index].kind == .QUEEN {
		path = pieces[index].color == .WHITE ? WHITE_QUEEN_MODEL: BLACK_QUEEN_MODEL;
	}
	pieces[index].entity = createModel(path, pieces[index].color == .WHITE ? MAT_WHITE: MAT_BLACK, pieces[index].base_pos);
}

fn addPiece(kind: PieceType, color: Color, x: i32, z: i32): void {
	const i = piece_count;
	const p = squarePos(x, z);
	const e = createModel(PIECE_MODELS[i], color == .WHITE ? MAT_WHITE: MAT_BLACK, p);
	pieces[i] = {
		e, kind, color, x, z, p, p.y, true, false, p, p, 0, 0.5, 0.5, false, p, p.y, p, -1, -1, false
	};
	setAt(x, z, i);
	piece_count += 1;
}

fn createPieces(): void {
	const majors: [8] PieceType = [.ROOK,.KNIGHT,.BISHOP,.QUEEN,.KING,.BISHOP,.KNIGHT,.ROOK];
	for i in 0 .. 8 {
		addPiece(majors[i],.WHITE, i + 1, 1);
	}
	for i in 0 .. 8 {
		addPiece(.PAWN,.WHITE, i + 1, 2);
	}
	for i in 0 .. 8 {
		addPiece(majors[i],.BLACK, i + 1, 8);
	}
	for i in 0 .. 8 {
		addPiece(.PAWN,.BLACK, i + 1, 7);
	}
}

fn anyAnimating(): bool {
	for i in 0 .. piece_count {
		if pieces[i].active and pieces[i].animating {
			return true;
		}
	}
	return false;
}

fn updateTurnText(): void {
	if current_turn == .WHITE {
		if isKingInCheck(.WHITE) {
			setTurnText("White's turn (Check!)");
		} else {
			setTurnText("White's turn");
		}
	}
	else {
		setTurnText("Black's turn");
	}
}

fn hasLegalMoves(color: Color): bool {
	return getAllValidMoves(color).size > 0;
}

fn checkGameOver(): bool {
	if isKingInCheck(.WHITE) and not hasLegalMoves(.WHITE) {
		setTurnText("Checkmate! Black wins!");
		return true;
	}
	if isKingInCheck(.BLACK) and not hasLegalMoves(.BLACK) {
		setTurnText("Checkmate! White wins!");
		return true;
	}
	if not isKingInCheck(current_turn) and not hasLegalMoves(current_turn) {
		setTurnText("Stalemate! Draw!");
		return true;
	}
	return false;
}

fn switchTurn(): void {
	current_turn = other(current_turn);
	updateTurnText();
	if checkGameOver() {
		game_over = true;
		return;
	}

	if current_turn == .BLACK {
		ai_timer = 0;
		ai_thinking = true;
		setTurnText(isKingInCheck(.BLACK) ? "AI is in check! Thinking...": "AI is thinking...");
	}
}

fn recordUndo(index: i32, from_x: i32, from_z: i32, to_x: i32, to_z: i32): void {
	undo_stack[undo_count] = {
		index, from_x, from_z, to_x, to_z, at(to_x, to_z), current_turn, pieces[index].has_moved, false, -1, 0, 0, false, false,.PAWN
	};
	undo_count += 1;
}

fn movePiece(index: i32, to_x: i32, to_z: i32): void {
	const from_x = pieces[index].x;
	const from_z = pieces[index].z;
	recordUndo(index, from_x, from_z, to_x, to_z);
	const captured = at(to_x, to_z);
	if captured >= 0 {
		pieces[captured].active = false;
		pieces[captured].current_y =-1000;
		pieces[captured].base_pos = {
			0, -1000, 0
		};
		applyPiecePosition(captured);
	}
	setAt(from_x, from_z, -1);
	setAt(to_x, to_z, index);
	pieces[index].x = to_x;
	pieces[index].z = to_z;
	if pieces[index].kind == .KING and absolute(to_x - from_x) == 2 {
		const rook_from: i32 = to_x > from_x ? 8: 1;
		const rook_to: i32 = to_x > from_x ? from_x + 1: from_x - 1;
		const rook = at(rook_from, from_z);
		if rook >= 0 {
			const u = & undo_stack[undo_count - 1];
			u.is_castling = true;
			u.rook = rook;
			u.rook_from_x = rook_from;
			u.rook_to_x = rook_to;
			u.rook_prev_has_moved = pieces[rook].has_moved;
			setAt(rook_from, from_z, -1);
			setAt(rook_to, from_z, rook);
			pieces[rook].x = rook_to;
			pieces[rook].has_moved = true;
			const rp = squarePos(rook_to, from_z);
			pieces[rook].anim_start = {
				pieces[rook].base_pos.x, pieces[rook].current_y, pieces[rook].base_pos.z
			};
			pieces[rook].anim_target = rp;
			pieces[rook].anim_lift = 0.5;
			pieces[rook].anim_time = 0;
			pieces[rook].anim_duration = 0.5;
			pieces[rook].animating = true;
		}
	}
	if pieces[index].kind == .PAWN and((pieces[index].color == .WHITE and to_z == 8) or(pieces[index].color == .BLACK and to_z == 1)) {
		const u = & undo_stack[undo_count - 1];
		u.was_promotion = true;
		u.old_type = pieces[index].kind;
		pieces[index].kind =.QUEEN;
		rebuildPieceModel(index);
	}
	pieces[index].has_moved = true;
	const target = squarePos(to_x, to_z);
	pieces[index].anim_start = {
		pieces[index].base_pos.x, pieces[index].current_y, pieces[index].base_pos.z
	};
	pieces[index].anim_target = target;
	pieces[index].anim_lift = pieces[index].current_y > target.y + 0.01 ? 0:(current_turn == .BLACK ? 1: 0.5);
	pieces[index].anim_time = 0;
	pieces[index].anim_duration = current_turn == .BLACK ? 1: 0.5;
	pieces[index].animating = true;
}

fn undoMove(): void {
	if dragging or dropping or anyAnimating() {
		return;
	}

	ai_thinking = false;
	ai_timer = 0;
	game_over = false;
	var count = 0;
	while undo_count > 0 and count < 2 {
		undo_count -= 1;
		const move = undo_stack[undo_count];
		const i = move.piece;
		setAt(move.to_x, move.to_z, -1);
		setAt(move.from_x, move.from_z, i);
		pieces[i].x = move.from_x;
		pieces[i].z = move.from_z;
		pieces[i].animating = false;
		pieces[i].anim_time = 0;
		pieces[i].has_moved = move.prev_has_moved;
		if move.was_promotion {
			pieces[i].kind = move.old_type;
			rebuildPieceModel(i);
		}
		const home = squarePos(move.from_x, move.from_z);
		pieces[i].base_pos = home;
		pieces[i].current_y = home.y;
		applyPiecePosition(i);
		if move.is_castling {
			const r = move.rook;
			setAt(move.rook_to_x, move.from_z, -1);
			setAt(move.rook_from_x, move.from_z, r);
			pieces[r].x = move.rook_from_x;
			pieces[r].z = move.from_z;
			pieces[r].animating = false;
			pieces[r].has_moved = move.rook_prev_has_moved;
			const rh = squarePos(move.rook_from_x, move.from_z);
			pieces[r].base_pos = rh;
			pieces[r].current_y = rh.y;
			applyPiecePosition(r);
		}
		if move.captured >= 0 {
			const c = move.captured;
			pieces[c].active = true;
			pieces[c].x = move.to_x;
			pieces[c].z = move.to_z;
			pieces[c].animating = false;
			const ch = squarePos(move.to_x, move.to_z);
			pieces[c].base_pos = ch;
			pieces[c].current_y = ch.y;
			setAt(move.to_x, move.to_z, c);
			applyPiecePosition(c);
		}
		current_turn = move.prev_turn;
		updateTurnText();
		count += 1;
	}
	dragging = false;
	dropping = false;
	dragged_piece =-1;
	if current_turn == .BLACK and not game_over {
		ai_thinking = true;
		setTurnText(isKingInCheck(.BLACK) ? "AI is in check! Thinking...": "AI is thinking...");
	}
}

fn restartGame(): void {
	if dragging or dropping or anyAnimating() {
		return;
	}

	for i in 0 .. piece_count {
		const e = pieces[i].entity;
		if e.isValid() {
			e.destroy();
		}
	}
	for i in 0 .. 64 {
		board[i] =-1;
	}
	piece_count = 0;
	undo_count = 0;
	current_turn =.WHITE;
	hovered_piece =-1;
	dragging = false;
	dropping = false;
	dragged_piece =-1;
	ai_thinking = false;
	ai_timer = 0;
	game_over = false;
	createPieces();
	updateTurnText();
}

fn makeAIMove(): void {
	if current_turn != .BLACK or game_over {
		return;
	}

	var moves = getAllValidMoves(.BLACK);
	if moves.size == 0 {
		return;
	}

	var best =-INF;
	var best_move: i32 =-1;
	for i in 0 .. moves.size {
		const move = moves.values[i];
		const captured = applyTemporary(move);
		var score = minimax(.BLACK, AI_MAX_DEPTH - 1, -INF, INF, false);
		undoTemporary(move, captured);
		score +=(evaluateMove(move) as f32 * 0.25) as i32;
		if score > best {
			best = score;
			best_move = i;
		}
	}
	if best_move >= 0 {
		const move = moves.values[best_move];
		movePiece(move.piece, move.to_x, move.to_z);
	}
}

fn squareFromPosition(p: Vec3): Square {
	const x = floori((p.x + 4 * SQUARE_SIZE) / SQUARE_SIZE) + 1;
	const z = floori((p.z + 4 * SQUARE_SIZE) / SQUARE_SIZE) + 1;
	return x >= 1 and x <= 8 and z >= 1 and z <= 8
	? Square {
		x, z
	}
	: Square {
		- 1, -1
	};
}

fn boardHit(): ? Vec3 {
	const c = game_camera else return null;
	const ray = c.getRay(mouse_pos);
	if ray.dir.y == 0 {
		return null;
	}

	const t =(0.308 - ray.origin.y) / ray.dir.y as f64;
	if t < 0 {
		return null;
	}

	return Vec3 {
		(ray.origin.x + ray.dir.x as f64 * t) as f32, 0.308,(ray.origin.z + ray.dir.z as f64 * t) as f32
	};
}

fn invalidDrop(): void {
	if pieces[dragged_piece].has_last_valid {
		const x = pieces[dragged_piece].last_valid_x;
		const z = pieces[dragged_piece].last_valid_z;
		movePiece(dragged_piece, x, z);
		dragging = false;
		dragged_piece =-1;
	}
	else {
		const home = squarePos(pieces[dragged_piece].x, pieces[dragged_piece].z);
		pieces[dragged_piece].target_base = home;
		pieces[dragged_piece].last_valid_base = home;
		pieces[dragged_piece].target_y = home.y;
		dropping = true;
		dragging = false;
	}
}

fn onInputEvent(input_event: InputEvent): void {
	if current_turn == .BLACK or game_over {
		return;
	}

	match input_event {
		case AxisEvent:
		if input_event.device_type == .MOUSE {
			mouse_pos = {
				input_event.x_abs, input_event.y_abs
			};
			mouse_pos_valid = true;
		}
		case ButtonEvent:
		if input_event.device_type == .MOUSE {
			if anyAnimating() {
				return;
			}
			// Keep the axis position used successfully for hover picking.

			// Button coordinates are only the initial fallback intended by chess.lua.

			if not mouse_pos_valid {
				mouse_pos = {
					input_event.x, input_event.y
				};
				mouse_pos_valid = true;
			}
			const hit = boardHit() else {
				if not input_event.down and dragging and dragged_piece >= 0 {
					invalidDrop();
				}
				return;
			};
			const square = squareFromPosition(hit);
			if square.x < 0 {
				if not input_event.down and dragging and dragged_piece >= 0 {
					invalidDrop();
				}
				return;
			}
			if input_event.down {
				const clicked = at(square.x, square.z);
				if clicked >= 0 and pieces[clicked].color == current_turn and not pieces[clicked].animating {
					dragging = true;
					dragged_piece = clicked;
					pieces[clicked].target_base = pieces[clicked].base_pos;
					pieces[clicked].last_valid_base = pieces[clicked].base_pos;
					pieces[clicked].has_last_valid = false;
					pieces[clicked].target_y = PIECE_HEIGHT + PIECE_Y_OFFSET + DRAG_LIFT;
				}
			}
			else if dragging and dragged_piece >= 0 {
				if isLegalMove(dragged_piece, pieces[dragged_piece].x, pieces[dragged_piece].z, square.x, square.z) {
					const i = dragged_piece;
					dragging = false;
					dragged_piece =-1;
					movePiece(i, square.x, square.z);
				} else {
					invalidDrop();
				}
			}
		}
		case:
	}
}

fn handleUI(): void {
	const module = world.ui() else return;
	if not module.isReady() {
		return;
	}
	for event in module.getDocument().getEvents() {
		if event.action == "undo" {
			undoMove();
		} else if event.action == "restart" {
			restartGame();
		}
	}
}

fn update(dt: f32): void {
	handleUI();
	hover_time += dt;
	const hit = boardHit();
	hovered_piece =-1;
	if const p = hit {
		const square = squareFromPosition(p);
		if square.x >= 0 {
			const candidate = at(square.x, square.z);
			if candidate >= 0 and pieces[candidate].color == current_turn and not dragging and not dropping and current_turn != .BLACK {
				hovered_piece = candidate;
			}
		}
	}
	if dragging and dragged_piece >= 0 {
		if const p = hit {
			const square = squareFromPosition(p);
			if square.x >= 0 {
				const i = dragged_piece;
				if isLegalMove(i, pieces[i].x, pieces[i].z, square.x, square.z) {
					const pos = squarePos(square.x, square.z);
					pieces[i].target_base = pos;
					pieces[i].last_valid_base = pos;
					pieces[i].last_valid_x = square.x;
					pieces[i].last_valid_z = square.z;
					pieces[i].has_last_valid = true;
				}
				else {
					pieces[i].target_base = pieces[i].last_valid_base;
				}
				pieces[i].target_y = PIECE_HEIGHT + PIECE_Y_OFFSET + DRAG_LIFT;
			}
		}
	}
	if (dragging or dropping) and dragged_piece >= 0 {
		const i = dragged_piece;
		const t = minimum(1, dt * SNAP_LERP_SPEED);
		pieces[i].base_pos.x +=(pieces[i].target_base.x - pieces[i].base_pos.x) * t;
		pieces[i].base_pos.y +=(pieces[i].target_base.y - pieces[i].base_pos.y) * t;
		pieces[i].base_pos.z +=(pieces[i].target_base.z - pieces[i].base_pos.z) * t;
		pieces[i].current_y +=(pieces[i].target_y - pieces[i].current_y) * t;
		applyPiecePosition(i);
		if dropping
		and absf(pieces[i].current_y - pieces[i].target_y) < 0.01
		and absf(pieces[i].base_pos.x - pieces[i].target_base.x) < 0.01
		and absf(pieces[i].base_pos.z - pieces[i].target_base.z) < 0.01
		{
			dropping = false;
			dragged_piece =-1;
		}
	}
	const bob = math.sin(hover_time * HOVER_BOB_SPEED) * HOVER_BOB_AMPLITUDE;
	var animation_finished = false;
	for i in 0 .. piece_count {
		if pieces[i].active {
			if i != dragged_piece and not pieces[i].animating {
				const target_y = pieces[i].base_pos.y +(i == hovered_piece ? HOVER_LIFT + bob: 0);
				pieces[i].current_y +=(target_y - pieces[i].current_y) * minimum(1, dt * HOVER_SMOOTH);
				applyPiecePosition(i);
			}
			if pieces[i].animating {
				pieces[i].anim_time += dt;
				var t = minimum(1, pieces[i].anim_time / pieces[i].anim_duration);
				t = t * t *(3 - 2 * t);
				const lift = pieces[i].anim_lift * math.sin(t * 3.14159265);
				pieces[i].base_pos.x = pieces[i].anim_start.x +(pieces[i].anim_target.x - pieces[i].anim_start.x) * t;
				pieces[i].base_pos.z = pieces[i].anim_start.z +(pieces[i].anim_target.z - pieces[i].anim_start.z) * t;
				pieces[i].current_y = pieces[i].anim_start.y +(pieces[i].anim_target.y - pieces[i].anim_start.y) * t + lift;
				applyPiecePosition(i);
				if pieces[i].anim_time >= pieces[i].anim_duration {
					pieces[i].animating = false;
					pieces[i].base_pos = pieces[i].anim_target;
					pieces[i].current_y = pieces[i].anim_target.y;
					applyPiecePosition(i);
					animation_finished = true;
				}
			}
		}
	}
	if animation_finished and not anyAnimating() {
		switchTurn();
	}
	if ai_thinking and not game_over {
		ai_timer += dt;
		if ai_timer >= AI_THINK_TIME {
			ai_thinking = false;
			makeAIMove();
		}
	}
}

fn start(): void {
	for & b in board {
		b =-1;
	}
	const camera_entity = world.createEntity();
	camera_entity.setName("camera");
	camera_entity.setPosition({ 0, 8, 5 });
	// Looking from {0, 8, 5} at the origin

	camera_entity.setRotation(makeQuatFromYaw(6.2831853) * makeQuatFromPitch(1.012197));
	game_camera = camera_entity.createCamera();
	if const module = world.ui() {
		module.load("chess/chess.ui");
		module.getSystem().enableCursor(true);
	}
	const board_entity = world.createEntity();
	board_entity.setName("board");
	position(board_entity, { 0, 0, 0 });
	board_entity.setRotation(MODEL_ROT_X90);
	board_entity.setScale({ CHESS_MODEL_SCALE, CHESS_MODEL_SCALE, CHESS_MODEL_SCALE });
	const model = board_entity.createModelInstance() else panic("Missing renderer");
	model.setPath(BOARD_MODEL);
	model.setMaterialOverride(0, MAT_BOARD);
	createPieces();
	updateTurnText();
	logInfoString("Chess game initialized");
}

fn main(input: InputSystem, w: World): void {
	world = w;
	start();
	while true {
		const dt: f32 = yield;
		for event in input.getEvents() {
			onInputEvent(event);
		}
		update(dt);
	}
}
