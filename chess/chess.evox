"Knight_low.003.fbx:chess/Chess_Set/Chess_Set.fbx", "Rook_low.003.fbx:chess/Chess_Set/Chess_Set.fbx",
"Pawn_low.008.fbx:chess/Chess_Set/Chess_Set.fbx", "Pawn_low.009.fbx:chess/Chess_Set/Chess_Set.fbx",
